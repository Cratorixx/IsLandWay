@page "/walkthrough"
@page "/guide"
@page "/travel-guide"
@inject ITransitService TransitService

<PageTitle>How to Board an Inter-Island Ferry: Pier-to-Pier Walkthrough | Islandway</PageTitle>

@if (Guide != null)
{
    <!-- Ambient oceanic luminous radial orbs in background -->
    <div class="fixed top-[-5%] right-[-5%] w-[650px] h-[650px] rounded-full bg-teal-500/10 blur-[130px] pointer-events-none -z-10"></div>
    <div class="fixed top-[30%] left-[-10%] w-[700px] h-[700px] rounded-full bg-cyan-600/10 blur-[150px] pointer-events-none -z-10"></div>
    <div class="fixed bottom-[10%] right-[10%] w-[550px] h-[550px] rounded-full bg-emerald-500/8 blur-[140px] pointer-events-none -z-10"></div>

    <!-- ==================== MAIN FULL-BLEED CONTENT CONTAINER ==================== -->
    <main class="w-full px-6 md:px-12 xl:px-16 py-8 relative z-10">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[12px] text-cyan-100/80 mb-8 font-medium">
            <a class="hover:text-white transition-colors duration-150" href="/">Home</a>
            <span class="text-white/40">&gt;</span>
            <a class="hover:text-white transition-colors duration-150" href="/routes">Routes &amp; Ports</a>
            <span class="text-white/40">&gt;</span>
            <span class="text-white font-semibold">Terminal &amp; Boarding Walkthrough</span>
        </nav>

        <!-- ==================== 2. IMMERSIVE HERO SECTION ==================== -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start mb-16">
            <!-- Left Column: Editorial Headline & Guidance -->
            <div class="lg:col-span-7 flex flex-col">
                <div class="inline-flex items-center gap-2 mb-3">
                    <span class="w-2 h-2 rounded-full bg-[#46E5D1] animate-pulse"></span>
                    <span class="text-[11px] font-bold tracking-widest text-[#46E5D1] uppercase">
                        @Guide.EyebrowCategory
                    </span>
                </div>
                <h1 class="font-editorial text-[36px] sm:text-[46px] lg:text-[48px] leading-[1.16] text-white font-semibold mb-4 tracking-tight drop-shadow-md text-balance">
                    @Guide.DisplayTitle
                </h1>
                <p class="text-[16px] leading-relaxed text-slate-200 mb-6 max-w-2xl font-normal text-pretty">
                    @Guide.SubtitleDescription
                </p>

                <!-- Meta strip -->
                <div class="flex flex-wrap items-center gap-3 text-[13px] text-cyan-100/90 mb-7 font-medium">
                    <span class="flex items-center gap-1.5 text-white">
                        <span class="material-symbols-outlined text-[18px] text-[#46E5D1]">schedule</span>
                        5 steps, 6 min read
                    </span>
                    <span class="text-white/30">•</span>
                    <span>For first-time travelers</span>
                    <span class="text-white/30">•</span>
                    <span>Visayas &amp; Central Seaports</span>
                </div>

                <!-- 3 Quick Info Chips (Translucent Frosted Glass Pills) -->
                <div class="flex flex-wrap items-center gap-3 mb-8">
                    @foreach (var chip in Guide.QuickChips)
                    {
                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-pill text-cyan-100 text-[12px] font-medium hover:bg-white/15 transition-all shadow-md">
                            <span class="material-symbols-outlined text-[17px] text-[#46E5D1]">@chip.MaterialIcon</span>
                            @chip.Text
                        </div>
                    }
                </div>

                <!-- Port Selector Bar (Frosted Glass Container) -->
                <div class="p-5 rounded-2xl glass-card shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-5 relative">
                    <div class="relative flex flex-col gap-1.5 w-full md:w-auto">
                        <span class="text-[10px] font-bold tracking-widest text-[#46E5D1] uppercase">DEPARTING PORT</span>
                        <button type="button"
                                @onclick="TogglePortDropdown"
                                class="flex items-center justify-between gap-3 px-4 py-2.5 bg-slate-900/60 backdrop-blur-md border border-white/20 rounded-xl cursor-pointer hover:border-[#46E5D1] hover:bg-slate-900/80 transition-all shadow-inner focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#46E5D1]">
                            <div class="flex items-center gap-2.5 text-[14px] font-semibold text-white">
                                <span class="material-symbols-outlined text-[19px] text-[#46E5D1]">directions_boat</span>
                                <span>@Guide.SelectedPortSample.PortSelectorLabel</span>
                            </div>
                            <span class="material-symbols-outlined text-[18px] text-cyan-200">expand_more</span>
                        </button>

                        @if (IsPortDropdownOpen)
                        {
                            <div class="absolute left-0 top-full mt-2 w-72 bg-[#041C2C]/95 backdrop-blur-xl border border-white/20 rounded-xl shadow-2xl py-2 z-40">
                                @foreach (var port in Guide.PortSamples)
                                {
                                    <button type="button"
                                            @onclick="() => SelectPortSample(port.Id)"
                                            class="w-full text-left px-4 py-2.5 text-[13px] font-medium text-slate-200 hover:bg-white/15 hover:text-[#46E5D1] transition-colors">
                                        @port.PortSelectorLabel
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="flex flex-col gap-1 border-t md:border-t-0 md:border-l border-white/15 pt-3 md:pt-0 md:pl-6 text-left">
                        <div class="text-[14px] font-bold text-white flex flex-wrap items-center gap-2">
                            <span>@Guide.SelectedPortSample.RouteSummaryTitle</span>
                            <span class="text-[#46E5D1] text-[12px] font-medium">@Guide.SelectedPortSample.CrossingDurationTag</span>
                        </div>
                        <p class="text-[12px] text-slate-200 max-w-md leading-relaxed">
                            @Guide.SelectedPortSample.AdvisoryNote
                        </p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Photographic Card with Floating Badge & Caption -->
            <div class="lg:col-span-5 flex flex-col">
                <div class="relative rounded-2xl overflow-hidden shadow-[0_16px_40px_rgba(0,0,0,0.45)] border border-white/20 group">
                    <img alt="@Guide.HeroImageAlt"
                         class="w-full h-[340px] sm:h-[380px] object-cover transition-transform duration-700 group-hover:scale-105"
                         src="@Guide.HeroImageUrl"
                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1540946485063-a40da27545f8?auto=format&fit=crop&w=1000&q=80';" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#041c2c]/90 via-transparent to-black/20"></div>
                    <!-- Floating badge caption (Frosted glass overlay) -->
                    <div class="absolute bottom-4 left-4 bg-slate-950/70 backdrop-blur-xl border border-white/30 px-4 py-2 rounded-full shadow-[0_8px_24px_rgba(0,0,0,0.4)] flex items-center gap-2 text-white text-[13px] font-medium">
                        <span class="material-symbols-outlined text-[17px] text-[#46E5D1]">anchor</span>
                        <span>@Guide.HeroImageBadgeCaption</span>
                    </div>
                </div>
                <p class="text-[12px] text-slate-300 text-center mt-3 italic">
                    @Guide.HeroImageSubCaption
                </p>
            </div>
        </section>

        <!-- ==================== 3. FIVE-STEP WALKTHROUGH SECTION ==================== -->
        <section class="mt-12 mb-20">
            <!-- Section Header -->
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-white/15 pb-5 mb-8 gap-3">
                <div>
                    <span class="text-[11px] font-bold tracking-widest text-[#46E5D1] uppercase block mb-1">
                        STEP-BY-STEP DEPARTURE GUIDE
                    </span>
                    <h2 class="font-editorial text-[28px] sm:text-[34px] font-semibold text-white tracking-tight">
                        Five steps. One smooth departure.
                    </h2>
                </div>
                <span class="text-[12px] text-slate-300 italic">
                    * Have ticket, valid government ID, and small bills before step 01.
                </span>
            </div>

            <!-- Horizontal Process Pills (Glassmorphic) -->
            <div class="flex flex-wrap items-center gap-2.5 mb-8 text-[12px] font-medium">
                @foreach (var step in Guide.Steps)
                {
                    var isActive = ActiveStepCode == step.StepNumberCode;
                    <button type="button"
                            @onclick="() => SelectActiveStep(step.StepNumberCode)"
                            class="px-4 py-2 rounded-full transition-all flex items-center gap-1.5 cursor-pointer @(isActive ? "bg-[#46E5D1] text-[#041C2C] font-bold border border-[#46E5D1] shadow-[0_0_15px_rgba(70,229,209,0.35)]" : "glass-pill text-slate-200 hover:bg-white/15 hover:text-white shadow-sm")">
                        <span class="font-bold @(isActive ? "text-[#041C2C]" : "text-white") tabular-nums">@step.StepNumberCode</span>
                        <span>@step.ShortPillLabel</span>
                    </button>
                }
            </div>

            <!-- The 5 Cards Stack (Frosted Glass Panels) -->
            <div class="flex flex-col gap-6">
                @foreach (var step in Guide.Steps)
                {
                    <WalkthroughStepCard Step="step" IsHighlighted="@(ActiveStepCode == step.StepNumberCode)" />
                }
            </div>

            <!-- Golden Port Rule Banner (Glassmorphic Translucent Banner) -->
            <div class="mt-8 p-5 rounded-2xl glass-card text-[14px] text-white flex items-center justify-center gap-3 font-medium shadow-xl">
                <span class="text-xl">🔑</span>
                <span><strong class="text-[#46E5D1]">Golden Port Rule:</strong> @Guide.GoldenPortRuleText</span>
            </div>
        </section>

        <!-- ==================== 4. ARRIVAL PORT LAST-MILE TRANSIT SECTION ==================== -->
        <section class="mt-16 mb-12 pt-10 border-t border-white/15">
            <!-- Section Header -->
            <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
                <div>
                    <span class="text-[11px] font-bold tracking-widest text-[#46E5D1] uppercase block mb-1">
                        ON THE ISLAND TURF
                    </span>
                    <h2 class="font-editorial text-[28px] sm:text-[32px] font-semibold text-white tracking-tight">
                        Arrival Port Last-Mile Transit
                    </h2>
                    <p class="text-[14px] text-slate-200 mt-1">
                        Leave the pier with confidence. Transparent local transport fares and official dispatch recommendations.
                    </p>
                </div>
                <div class="shrink-0">
                    <span class="px-4 py-2 rounded-full bg-amber-400/10 backdrop-blur-md border border-amber-400/30 text-amber-300 text-[12px] font-semibold shadow-sm">
                        Official estimates • 2024–2025 rates
                    </span>
                </div>
            </div>

            <!-- 3 Vehicle Cards (Frosted Glass Panels with glowing badges) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                @foreach (var vehicle in Guide.LastMileOptions)
                {
                    <LastMileVehicleCard Vehicle="vehicle" />
                }
            </div>

            <!-- Translucent Warning Banner -->
            <div class="w-full glass-card border border-cyan-400/30 text-white rounded-2xl p-5 flex items-start sm:items-center gap-4 shadow-xl relative overflow-hidden">
                <div class="w-10 h-10 rounded-full bg-[#46E5D1]/20 border border-[#46E5D1]/40 text-[#46E5D1] flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">info</span>
                </div>
                <div class="text-[13px] leading-relaxed text-slate-200 relative z-10">
                    <strong class="text-white">Confirm the route, total fare, and luggage charges before you ride.</strong>
                    <span class="block sm:inline sm:ml-1 text-cyan-100">Fares vary by island and distance. Always choose the official dispatch counter and decline unsolicited middleman offers.</span>
                </div>
            </div>

            <!-- Bottom Navigation Bar (Prevents Stranded UX) -->
            <div class="mt-10 pt-6 border-t border-white/15 flex flex-col sm:flex-row items-center justify-between gap-4">
                <a href="/routes" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl glass-pill text-xs font-semibold text-white hover:bg-white/15 transition-all">
                    <i class="fa-solid fa-arrow-left text-[#46E5D1]"></i>
                    <span>Back to Ferry Schedules &amp; Routes</span>
                </a>
                <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#00A896] to-[#46E5D1] text-[#041C2C] text-xs font-bold shadow-[0_0_20px_rgba(70,229,209,0.25)] hover:brightness-110 transition-all">
                    <span>Return to Home Route Finder</span>
                    <i class="fa-solid fa-house text-[11px]"></i>
                </a>
            </div>
        </section>
    </main>
}

@code {
    private BoardingWalkthroughGuide? Guide { get; set; }
    private string ActiveStepCode { get; set; } = "01";
    private bool IsPortDropdownOpen { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Guide = await TransitService.GetBoardingWalkthroughGuideAsync();
    }

    private void TogglePortDropdown()
    {
        IsPortDropdownOpen = !IsPortDropdownOpen;
    }

    private void SelectPortSample(string portId)
    {
        var sample = TransitService.FindPortSampleById(Guide, portId);
        if (sample != null)
        {
            Guide?.ApplyPortSample(sample);
        }
        IsPortDropdownOpen = false;
    }

    private void SelectActiveStep(string stepCode)
    {
        ActiveStepCode = stepCode;
    }
}
