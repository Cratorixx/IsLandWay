            Home
        </NavLink>
        <NavLink href="routes" Match="NavLinkMatch.Prefix" class="hidden md:inline-block text-[14px] leading-[17px] font-medium text-white/90 hover:text-[#7FE0D3] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#7FE0D3] rounded py-1" ActiveClass="font-semibold !text-[#7FE0D3]">
            Routes &amp; Ports
        </NavLink>
        <NavLink href="walkthrough" Match="NavLinkMatch.Prefix" class="hidden md:inline-block text-[14px] leading-[17px] font-medium text-white/90 hover:text-[#7FE0D3] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#7FE0D3] rounded py-1" ActiveClass="font-semibold !text-[#7FE0D3]">
            Travel Guide
        </NavLink>
        <a class="hidden lg:inline-block text-[14px] leading-[17px] font-medium text-white/90 hover:text-[#7FE0D3] transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#7FE0D3] rounded" href="/#vessels">
