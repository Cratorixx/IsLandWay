@if (Vessel != null)
{
    var specs = Vessel.GetSpecifications();

    <div class="backdrop-blur-xl bg-white/10 rounded-2xl border border-white/20 overflow-hidden flex flex-col shadow-[0_8px_32px_rgba(0,0,0,0.25)] hover:border-white/35 transition-all duration-300">
        <!-- Photo Header with Badge -->
        <div class="relative w-full h-[180px] overflow-hidden bg-slate-900/40">
            <img alt="@Vessel.ImageAlt"
                 class="w-full h-full object-cover"
                 src="@Vessel.ImageUrl"
                 onerror="this.onerror=null;this.src='https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg';" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <span class="absolute top-[16px] left-[16px] bg-[#0A2540]/80 backdrop-blur-md border border-white/20 text-[#7FE0D3] text-[10px] font-semibold px-[10px] py-[5px] rounded-full uppercase tracking-wider">
                @Vessel.GetUsageBadgeText()
            </span>
        </div>

        <!-- Specs Content -->
        <div class="p-[24px] flex flex-col gap-[16px]">
            <div class="flex items-center justify-between">
                <h3 class="text-[22px] font-bold text-white">@Vessel.DisplayTitle</h3>
                <div class="w-[36px] h-[36px] rounded-full bg-white/10 border border-white/20 flex items-center justify-center text-[#7FE0D3] text-[16px]">
                    <i class="@Vessel.GetHeaderIconClass()"></i>
                </div>
            </div>

            <!-- 2x2 Specs Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-[10px]">
                @foreach (var spec in specs)
                {
                    <div class="bg-white/5 border border-white/10 rounded-xl p-[12px] flex items-center gap-[10px]">
                        <i class="@spec.IconClass text-[#7FE0D3] text-[15px] w-5 text-center flex-shrink-0"></i>
                        <div class="flex flex-col min-w-0">
                            <span class="text-[10px] text-[#BBCBD7]">@spec.Label</span>
                            <span class="text-[13px] font-bold text-white truncate">@spec.Value</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public FerryVesselBase? Vessel { get; set; }
}
