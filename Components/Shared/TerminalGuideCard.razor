@if (Guide != null)
{
    <div class="bg-white/10 backdrop-blur-xl rounded-2xl border border-white/15 p-6 space-y-4 shadow-[0_8px_32px_rgba(0,0,0,0.2)]">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#00F0D0]/10 border border-[#00F0D0]/30 flex items-center justify-center text-[#00F0D0]">
                @if (Guide.IsDepartureTerminal())
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                }
                else
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
                    </svg>
                }
            </div>
            <div>
                <h3 class="font-bold text-base text-white">@Guide.GetTerminalRolePrefix(): @Guide.DisplayTitle</h3>
                <p class="text-xs text-white/60">@Guide.PortLocationSubtitle</p>
            </div>
        </div>

        <div class="space-y-2 text-xs text-white/80">
            @foreach (var step in Guide.Steps)
            {
                <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10">
                    <span class="w-5 h-5 rounded-full bg-[#00F0D0]/20 text-[#00F0D0] flex items-center justify-center font-bold text-[11px] shrink-0 tabular-nums">
                        @step.StepNumber
                    </span>
                    <p>
                        <strong class="text-white">@step.HighlightLabel</strong> @step.InstructionText
                    </p>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public TerminalPortGuideBase? Guide { get; set; }
}
