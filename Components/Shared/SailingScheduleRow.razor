@if (Sailing != null)
{
    <div class="py-3 px-4 bg-white/5 hover:bg-white/10 backdrop-blur-md border border-white/10 hover:border-[#00F0D0]/40 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all">
        <div class="flex items-center gap-4">
            <div class="w-16 tabular-nums">
                <span class="text-base font-bold text-white">@Sailing.DepartureTime24h</span>
                <span class="block text-[11px] text-white/50">@Sailing.ArrivalTimeFormatted</span>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="font-semibold text-white">@Sailing.DisplayTitle</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold @Sailing.GetServiceBadgeCssClass()">
                        @Sailing.GetServiceBadgeText()
                    </span>
                </div>
                <span class="text-xs text-white/60">@Sailing.BerthRouteText</span>
            </div>
        </div>

        <div class="flex items-center justify-between sm:justify-end gap-5">
            <div class="text-right tabular-nums">
                <span class="font-bold text-white text-base">@Sailing.GetFormattedPrice()</span>
                <span class="block text-[10px] @Sailing.AvailabilityColorClass font-semibold">@Sailing.AvailabilityStatus</span>
            </div>
            @if (Sailing.IsPrimaryActionStyle())
            {
                <button type="button"
                        @onclick="HandleActionClick"
                        class="px-4 py-2 bg-gradient-to-r from-[#00A896] to-[#00F0D0] hover:brightness-110 text-[#041C2C] font-bold text-xs rounded-xl shadow-[0_0_15px_rgba(0,240,208,0.25)] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00F0D0]">
                    @Sailing.GetActionButtonLabel()
                </button>
            }
            else
            {
                <button type="button"
                        @onclick="HandleActionClick"
                        class="px-4 py-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-xs rounded-xl transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#00F0D0]">
                    @Sailing.GetActionButtonLabel()
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public SailingScheduleBase? Sailing { get; set; }

    [Parameter]
    public EventCallback<SailingScheduleBase> OnActionSelected { get; set; }

    private async Task HandleActionClick()
    {
        if (Sailing != null)
        {
            await OnActionSelected.InvokeAsync(Sailing);
        }
    }
}
